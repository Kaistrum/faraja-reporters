# Reporters app env — copy to .env.local
# Faraja AI service (server-side — /api/chat proxies to it)
FARAJA_URL=http://localhost:8088

# Reports backend database (server-side — /api/survey proxies to it).
# Full endpoint URL, not a base to append a path to. Each submission
# carries a `reportId` (generated per-request) that also tags the photo
# uploaded to Cloudinary, so the backend can correlate a report row with
# its stored image. The image never goes to CLASSIFIER_URL from this
# app — it goes to Cloudinary only; classification (if any) happens
# backend-side after the bucket hands it off to a queue.
REPORTS_API_URL=http://localhost:5000/reports

# Cloudinary (server-side — /api/survey uploads photos here before sending
# the report itself to REPORTS_API_URL). Get these from your Cloudinary
# dashboard: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Image classifier
CLASSIFIER_URL=http://localhost:6000
